          "question_hi": "क्या आप पुष्टि करते हैं कि उत्पाद हस्तनिर्मित हैं?",
          "type": "checkbox",
          "required": true
        }
      ]
    },
    {
      "section_id": "flipkart_samarth_details",
      "section_name": "Flipkart Samarth Details",
      "section_name_hi": "फ्लिपकार्ट समर्थ विवरण",
      "show_when": {
        "field_id": "marketplace_channel",
        "equals": "flipkart_samarth"
      },
      "fields": [
        {
          "field_id": "flipkart_seller_type",
          "label": "Seller type",
          "label_hi": "विक्रेता का प्रकार",
          "question": "What type of seller are you?",
          "question_hi": "आप किस प्रकार के विक्रेता हैं?",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "individual_artisan",
              "label": "Individual artisan",
              "label_hi": "व्यक्तिगत कारीगर"
            },
            {
              "value": "self_help_group",
              "label": "Self-help group",
              "label_hi": "स्वयं सहायता समूह"
            },
            {
              "value": "cooperative",
              "label": "Cooperative",
              "label_hi": "सहकारी संस्था"
            },
            {
              "value": "small_business",
              "label": "Small business",
              "label_hi": "लघु व्यवसाय"
            }
          ]
        },
        {
          "field_id": "flipkart_product_category",
          "label": "Primary product category",
          "label_hi": "मुख्य उत्पाद श्रेणी",
          "question": "What is your primary product category?",
          "question_hi": "आपकी मुख्य उत्पाद श्रेणी क्या है?",
          "type": "text",
          "required": true
        },
        {
          "field_id": "flipkart_samarth_declaration",
          "label": "Samarth-program declaration",
          "label_hi": "समर्थ कार्यक्रम घोषणा",
          "question": "Do you confirm that you are an artisan or eligible small producer?",
          "question_hi": "क्या आप पुष्टि करते हैं कि आप कारीगर या पात्र लघु उत्पादक हैं?",
          "type": "checkbox",
          "required": true
        }
      ]
    },
    {
      "section_id": "ondc_seller_details",
      "section_name": "ONDC Seller Network Details",
      "section_name_hi": "ONDC विक्रेता नेटवर्क विवरण",
      "show_when": {
        "field_id": "marketplace_channel",
        "equals": "ondc"
      },
      "fields": [
        {
          "field_id": "ondc_seller_network_participant",
          "label": "Seller network participant",
          "label_hi": "विक्रेता नेटवर्क प्रतिभागी",
          "question": "Please select an ONDC seller-network participant.",
          "question_hi": "कृपया ONDC विक्रेता नेटवर्क प्रतिभागी चुनें।",
          "type": "select",
          "required": true,
          "options_source": "integration_configuration"
        },
        {
          "field_id": "ondc_store_name",
